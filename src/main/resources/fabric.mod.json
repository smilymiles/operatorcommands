{
	"schemaVersion": 1,
	"id": "operatorcommands",
	"version": "${version}",
	"name": "Operatorcommands",
	"description": "Allows you to use operator commands in singleplayer without enabling cheats!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/operatorcommands/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.opcommands.Operatorcommands"
		],
		"client": [
			"com.opcommands.client.OperatorcommandsClient"
		]
	},
	"mixins": [
		"operatorcommands.mixins.json",
		{
			"config": "operatorcommands.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}